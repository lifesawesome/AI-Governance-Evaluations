# Azure AI Foundry Configuration
AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
TENANT_ID=<your-tenant-id>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Application Insights (for production monitoring - Lab 8)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
APP_INSIGHTS_WORKSPACE_ID=<your-log-analytics-workspace-id>

# Azure AI Search (for RAG evaluation - Lab 5)
AZURE_AI_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_AI_SEARCH_INDEX=contoso-policies

# Azure DevOps (for CI/CD - Lab 7)
AZURE_DEVOPS_ORG=https://dev.azure.com/<your-org>
AZURE_DEVOPS_PROJECT=<your-project>
